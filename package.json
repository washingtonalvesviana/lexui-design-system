{
  "name": "lexui-workspace",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "storybook": "pnpm --filter @lexui/storybook dev",
    "demo": "pnpm --filter @lexui/demo-saas dev",
    "lexui:check": "node packages/cli/bin/lexui.mjs check",
    "lexui:doctor": "node packages/cli/bin/lexui.mjs doctor",
    "lexui:info": "node packages/cli/bin/lexui.mjs info",
    "lexui:build": "node packages/cli/bin/lexui.mjs build",
    "test": "pnpm --filter @lexui/tokens build && pnpm --filter @lexui/react build && pnpm --filter @lexui/charts build && node --test tests/*.test.mjs",
    "pack": "node scripts/pack-packages.mjs",
    "icons:reference": "node scripts/collect-icons.mjs"
  },
  "devDependencies": {
    "turbo": "latest",
    "typescript": "^6.0.0"
  }
}
