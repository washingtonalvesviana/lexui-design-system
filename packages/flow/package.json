{
  "name": "@lexui/flow",
  "version": "0.6.1",
  "description": "Tokenized React Flow wrappers for the LexUI design system",
  "license": "MIT",
  "type": "module",
  "sideEffects": ["**/*.css"],
  "files": ["dist", "README.md"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "types": "./dist/index.d.ts",
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19"
  },
  "dependencies": {
    "@xyflow/react": "^12.11.6"
  },
  "devDependencies": {
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "react": "latest",
    "react-dom": "latest"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node ./scripts/build-styles.mjs",
    "typecheck": "tsc --noEmit"
  },
  "publishConfig": { "access": "public" }
}
